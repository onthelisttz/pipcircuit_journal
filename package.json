{
  "name": "personal-journal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun run build:line-tools && next build",
    "build:line-tools": "node scripts/build-line-tools.mjs",
    "mt5:bridge:build": "node scripts/build-mt5-bridge.mjs",
    "mt5:service:build": "npm run mt5:bridge:build && node scripts/build-mt5-service.mjs",
    "mt5:service:bundle": "npm run mt5:service:build && node scripts/build-mt5-service-bundle.mjs",
    "mt5:service:install": "npm run mt5:service:build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-mt5-service-task.ps1",
    "mt5:service:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/unregister-mt5-service-task.ps1",
    "mt5:service": "node local-services/mt5-history-service/history-reader.mjs --serve",
    "ctrader:live:service": "node local-services/ctrader-live-service/server.mjs",
    "postinstall": "patch-package",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "format": "prettier --write .",
    "db:push": "supabase db push"
  },
  "dependencies": {
    "@reiryoku/ctrader-layer": "^2.2.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.93.1",
    "@tanstack/react-query": "^5.90.20",
    "@tiptap/extension-color": "^3.19.0",
    "@tiptap/extension-image": "^3.17.1",
    "@tiptap/extension-link": "^3.17.1",
    "@tiptap/extension-placeholder": "^3.17.1",
    "@tiptap/extension-text-style": "^3.19.0",
    "@tiptap/react": "^3.17.1",
    "@tiptap/starter-kit": "^3.17.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.2.0",
    "framer-motion": "^12.29.2",
    "lightweight-charts": "^5.1.0",
    "lightweight-charts-line-tools-core": "github:difurious/lightweight-charts-line-tools-core",
    "lightweight-charts-line-tools-freehand": "github:difurious/lightweight-charts-line-tools-freehand",
    "lightweight-charts-line-tools-lines": "github:difurious/lightweight-charts-line-tools-lines",
    "lightweight-charts-line-tools-long-short-position": "github:difurious/lightweight-charts-line-tools-long-short-position",
    "lightweight-charts-line-tools-path": "github:difurious/lightweight-charts-line-tools-path",
    "lightweight-charts-line-tools-rectangle": "github:difurious/lightweight-charts-line-tools-rectangle",
    "lucide-react": "^0.563.0",
    "next": "16.1.5",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.5",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "rollup": "^4.50.2",
    "supabase": "^2.76.6",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver",
    "supabase"
  ]
}
